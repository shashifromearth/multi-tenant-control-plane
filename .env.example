# Optional overrides for docker compose (copy to .env). Defaults work out of the box.
POSTGRES_USER=controlplane
POSTGRES_PASSWORD=change-me
POSTGRES_DB=controlplane
RABBITMQ_USER=controlplane
RABBITMQ_PASSWORD=change-me
LOG_LEVEL=INFO
WORKER_FAIL_RATE=0
WORKER_MIN_DELAY_MS=500
WORKER_MAX_DELAY_MS=2000
WORKER_DUPLICATE_RATE=0
WORKER_OUT_OF_ORDER_RATE=0
